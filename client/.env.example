WEBSITE_URL=http://localhost:3000 # Add the correct ENV var for this onto your hosting platform, point it to your production website.
ENVIRONMENT=development

# Port the dev server and `vite preview` bind to. Change it (along with
# strapi/.env's PORT and CLIENT_URL) to run alongside another LaunchPad stack.
PORT=3000

# Strapi backend URL (client + server visible)
VITE_STRAPI_URL=http://localhost:1337

# Preview / draft mode secret (server only).
# Generated by `yarn setup` and written to strapi/.env too — the two MUST match
# or Strapi's preview URLs come back 401. `yarn check:env` verifies this.
PREVIEW_SECRET=preview_secret

# Revalidation webhook secret (server only). Strapi sends
# `Authorization: Bearer <secret>` when posting to /api/revalidate.
# Configure in Strapi admin → Settings → Webhooks → Headers.
REVALIDATE_SECRET=tobemodified

# Session cookie secret (server only).
# Signs + encrypts the HttpOnly auth-session cookie set on sign-up / sign-in.
# MUST be at least 32 characters. Generate one with:
#   openssl rand -base64 48
# Rotate on a cadence. Rotating invalidates every existing session cookie.
SESSION_SECRET=tobemodified
